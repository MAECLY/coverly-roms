{
  "name": "coverly-roms",
  "private": true,
  "version": "0.2.0",
  "description": "Audit and fill the missing cover art of your ROM library.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json,md}\" \"locales/**/*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json,md}\" \"locales/**/*.json\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check-all": "pnpm tokens:check && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "prepare": "husky",
    "icons": "node scripts/icons/generate.mjs",
    "tokens": "node scripts/brand/build_tokens.mjs",
    "tokens:check": "node scripts/brand/build_tokens.mjs --check",
    "system-icons": "node scripts/icons/systems.mjs"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toggle": "1.2.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-virtual": "^3.13",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.59.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "2.0.8",
    "tailwind-merge": "2.6.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "10.0.1",
    "@resvg/resvg-js": "2.6.2",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "autoprefixer": "^10.6.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "30.1.2",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.0",
    "prettier": "^3.9.10",
    "svg-path-bbox": "2.1.0",
    "svgo": "4.1.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "1.0.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@7": "^7.29.6",
      "baseline-browser-mapping@2": "^2.11.0",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@5": "^5.0.12",
      "browserslist@4": "^4.28.7",
      "fast-uri@3": "^3.1.8",
      "js-yaml@4": "^4.3.2",
      "nanoid@3": "^3.3.18",
      "postcss@8": "^8.5.23",
      "postcss-selector-parser@6": "^6.1.3",
      "source-map-js@1": "^1.2.2"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint-plugin-jsx-a11y>eslint": "10",
        "eslint-plugin-react>eslint": "10"
      }
    }
  }
}
