{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coverly ROMs",
  "identifier": "com.maecly.coverlyroms",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1431",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Coverly ROMs",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "category": "Utility",
    "shortDescription": "ROM cover art auditor",
    "longDescription": "Find and add the missing cover art in your ROM library.",
    "copyright": "Copyright (C) 2026 Miguel Angel Esparza Calero (MAECLY). Licensed under AGPL-3.0-only.",
    "publisher": "Maecly"
  }
}
